{
  "expo": {
    "name": "CaseSeal",
    "slug": "scanipro",
    "owner": "hyperadrenax",
    "scheme": "caseseal",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#070B14",
    "ios": {
      "bundleIdentifier": "com.hyperadrenax.caseseal",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSCameraUsageDescription": "CaseSeal uses the camera only to scan documents and QR codes you choose. Scans are processed and stored on this iPhone and are never uploaded.",
        "NSFaceIDUsageDescription": "CaseSeal uses Face ID to lock your case files. Face ID data stays with iOS and is never accessible to CaseSeal."
      },
      "entitlements": {
        "com.apple.developer.default-data-protection": "NSFileProtectionComplete"
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1",
              "0A2A.1",
              "3B52.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1",
              "85F4.1"
            ]
          }
        ]
      },
      "deploymentTarget": "16.4"
    },
    "android": {
      "package": "com.hyperadrenax.caseseal",
      "adaptiveIcon": {
        "backgroundColor": "#070B14",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "blockedPermissions": [
        "android.permission.INTERNET_ADS",
        "com.google.android.gms.permission.AD_ID"
      ],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#F3F5FB",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#070B14"
          }
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "CaseSeal uses Face ID to lock your case files. Face ID data stays with iOS and is never accessible to CaseSeal."
        }
      ],
      [
        "react-native-document-scanner-plugin",
        {
          "cameraPermission": "CaseSeal uses the camera only to scan documents and QR codes you choose. Scans are processed and stored on this iPhone and are never uploaded."
        }
      ],
      [
        "expo-sqlite",
        {
          "enableFTS": true
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-web-browser",
      "expo-iap",
      [
        "expo-camera",
        {
          "cameraPermission": "CaseSeal uses the camera only to scan documents and QR codes you choose. Scans are processed and stored on this iPhone and are never uploaded.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "CaseSeal opens your photo library only when you choose photos to import as evidence. Imported photos stay on this iPhone.",
          "cameraPermission": "CaseSeal uses the camera only to scan documents and QR codes you choose. Scans are processed and stored on this iPhone and are never uploaded.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "proProductId": "com.hyperadrenax.caseseal.pro",
      "supportUrl": "https://caseseal.pages.dev/support",
      "privacyUrl": "https://caseseal.pages.dev/privacy",
      "supportEmail": "REPLACE_WITH_SUPPORT_EMAIL",
      "router": {},
      "eas": {
        "projectId": "7e7d5585-ebc2-4247-812e-9841c6a7d4e3"
      }
    }
  }
}
